#include <graphics.h>
#include <conio.h>
#include <iostream>

using namespace std;

int main()
{
    int gd = DETECT, gm;
    initgraph(&gd, &gm, "");

    int x1, y1, x2, y2;
    float sx, sy;

    cout << "Enter rectangle coordinates (x1 y1 x2 y2): ";
    cin >> x1 >> y1 >> x2 >> y2;

    cout << "Enter scaling factors sx and sy: ";
    cin >> sx >> sy;

    setcolor(WHITE);
    rectangle(x1, y1, x2, y2);
    outtextxy(x1, y1 + 10, "Original");

    int sx1 = x1 * sx;
    int sy1 = y1 * sy;
    int sx2 = x2 * sx;
    int sy2 = y2 * sy;

    setcolor(RED);
    rectangle(sx1, sy1, sx2, sy2);
    outtextxy(sx1, sy1 + 10, "Scaled");

    getch();
    closegraph();
    return 0;
}


