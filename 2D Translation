#include <graphics.h>
#include <conio.h>
#include <iostream>

using namespace std;

int main()
{

    int gd = DETECT, gm;
    initgraph(&gd, &gm, "");
    
    int x1, y1, x2, y2;
    int tx, ty;

    cout << "Enter rectangle coordinates (x1 y1 x2 y2): ";
    cin >> x1 >> y1 >> x2 >> y2;

    cout << "Enter translation factors tx and ty: ";
    cin >> tx >> ty;

    setcolor(WHITE);
    rectangle(x1, y1, x2, y2);
    outtextxy(x1, y1 - 10, "Original");

    setcolor(RED);
    rectangle(x1 + tx, y1 + ty, x2 + tx, y2 + ty);
    outtextxy(x1 + tx, y1 + ty - 10, "Translated");

    getch();
    closegraph();
    return 0;
}